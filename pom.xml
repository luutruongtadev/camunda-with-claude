<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>camunda-starter</artifactId>
  <version>0.0.1</version>

  <properties>
    <java.version>21</java.version>
    <!-- giữ cùng minor với cluster (c8run 8.9.x) -->
    <camunda.version>8.9.22</camunda.version>
    <!-- Camunda 8.9 client is built against httpclient5 5.6.4, which still has
         HttpAsyncClientBuilder.disableContentCompression(). Spring Boot 4.0.8's BOM
         manages httpclient5 to 5.5.2, which removed it, so pin to Camunda's version. -->
    <httpclient5.version>5.6.4</httpclient5.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-spring-boot-starter</artifactId>
      <version>${camunda.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
